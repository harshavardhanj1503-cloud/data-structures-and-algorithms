public class Solution {
    public string LongestPalindrome(string s) {
        string str="";
       for(int i=0;i<s.Length;i++){
        for(int j=i;j<s.Length;j++){
            string sub=s.Substring(i,j-i+1);
        if(CheckPlaindrome(sub)&& sub.Length>str.Length){
         str=sub;
         }
       } 
       }
       return str;
    }

    public static bool CheckPlaindrome(string s){
       int left=0;
       int right=s.Length-1;
        while(left<right){
           if(s[left]!=s[right]){
            return false;
           }
           left++;
           right--;
        }
        return true;
    }
}
